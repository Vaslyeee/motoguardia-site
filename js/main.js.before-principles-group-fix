/* =========================================================
   FINAL FIX — diagonal scroll text reveal for manifesto
========================================================= */

(function () {
  const manifestoSection = document.querySelector("#manifesto, .manifesto");
  if (!manifestoSection) return;

  if (manifestoSection.dataset.diagonalRevealReady === "1") return;
  manifestoSection.dataset.diagonalRevealReady = "1";

  const manifestoText =
    manifestoSection.querySelector(".manifesto__text") ||
    manifestoSection.querySelector(".manifesto__quote") ||
    manifestoSection.querySelector(".manifesto__lead") ||
    manifestoSection.querySelector(".manifesto__description");

  if (!manifestoText) return;

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

  function updateManifestoReveal() {
    const rect = manifestoSection.getBoundingClientRect();
    const vh = window.innerHeight || document.documentElement.clientHeight;

    /*
          0 — когда блок только снизу появляется
          1 — когда хорошо прошёл в зону просмотра
        */
    const rawProgress = (vh - rect.top) / (vh + rect.height * 0.35);
    const progress = clamp(rawProgress, 0, 1);

    const brightStart = progress * 100;
    const softEnd = clamp(brightStart - 18, 0, 100);

    manifestoText.style.setProperty("--diag-soft-end", softEnd + "%");
    manifestoText.style.setProperty("--diag-bright-start", brightStart + "%");
  }

  let ticking = false;

  function requestUpdate() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateManifestoReveal();
      ticking = false;
    });
  }

  updateManifestoReveal();

  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", requestUpdate);
})();

/* =====================================================
   MANIFESTO DIAGONAL REVEAL
===================================================== */

(function () {
  const section = document.querySelector("#manifesto, .manifesto");

  if (!section) return;

  const text =
    section.querySelector(".manifesto__text") ||
    section.querySelector(".manifesto__quote") ||
    section.querySelector(".manifesto__lead");

  if (!text) return;

  function update() {
    const rect = section.getBoundingClientRect();

    const height = window.innerHeight;

    let progress = (height - rect.top) / (height + rect.height);

    progress = Math.max(0, Math.min(1, progress));

    const x = 120 - progress * 240;

    const y = 120 - progress * 240;

    text.style.backgroundPosition = `${x}% ${y}%`;
  }

  window.addEventListener("scroll", update, { passive: true });

  update();
})();

const manifestoLines = document.querySelectorAll(".manifesto-final__line");

function animateManifesto() {
  manifestoLines.forEach((line) => {
    const rect = line.getBoundingClientRect();

    const progress = Math.min(
      Math.max(1 - rect.top / window.innerHeight, 0),
      1,
    );

    const pos = 100 - progress * 200;

    line.style.backgroundPosition = `${pos}% ${pos}%`;
  });
}

window.addEventListener("scroll", animateManifesto, { passive: true });

animateManifesto();

