/* === MANIFESTO + CARD SCROLL FIX START === */

document.addEventListener("DOMContentLoaded", () => {
  const cardSelectors = [
    ".principle-card",
    ".principles__card",
    ".audience-card",
    ".audience__card",
    ".system-card",
    ".system__card",
    ".direction-card",
    ".direction__card",
    ".directions__card",
    ".team-card",
    ".team__card",
    ".opportunity-card",
    ".opportunities__card",
    ".education__step",
    ".education__photo",
  ];

  const cards = [...document.querySelectorAll(cardSelectors.join(","))];

  cards.forEach((card, index) => {
    card.classList.add("scroll-reveal-card");
    card.style.transitionDelay = `${Math.min((index % 6) * 55, 275)}ms`;
  });

  if (cards.length) {
    const cardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle("is-visible", entry.isIntersecting);
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -6% 0px",
      },
    );

    cards.forEach((card) => cardObserver.observe(card));
  }

  const manifesto = document.querySelector("#manifesto");
  const text = manifesto?.querySelector(".manifesto-final__text");

  if (!manifesto || !text) return;

  const lines = [...text.querySelectorAll(".manifesto-final__line")];

  lines.forEach((line) => {
    if (line.dataset.ready === "1") return;

    const raw = line.textContent;
    line.innerHTML = "";

    [...raw].forEach((ch) => {
      const span = document.createElement("span");
      span.className =
        ch === " " ? "manifesto-final__char space" : "manifesto-final__char";
      span.innerHTML = ch === " " ? "&nbsp;" : ch;
      line.appendChild(span);
    });

    line.dataset.ready = "1";
  });

  const chars = [
    ...text.querySelectorAll(".manifesto-final__char:not(.space)"),
  ];
  if (!chars.length) return;

  const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
  let raf = null;

  const update = () => {
    const rect = manifesto.getBoundingClientRect();
    const vh = window.innerHeight;

    const start = vh * 0.82;
    const end = vh * 0.26;
    const progress = clamp((start - rect.top) / (start - end), 0, 1);
    const litCount = Math.floor(progress * (chars.length + 8));

    chars.forEach((char, index) => {
      char.classList.toggle("is-lit", index < litCount);
    });
  };

  const requestUpdate = () => {
    if (raf) return;

    raf = requestAnimationFrame(() => {
      update();
      raf = null;
    });
  };

  window.addEventListener("scroll", requestUpdate, { passive: true });
  window.addEventListener("resize", requestUpdate);

  update();
});

