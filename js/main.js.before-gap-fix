document.addEventListener('DOMContentLoaded', () => {

    const sections = [...document.querySelectorAll('section, div')];

    const manifesto = sections.find((el) => {
        const text = (el.innerText || '').replace(/\s+/g, ' ').trim();

        return (
            text.includes('Легион Мото Гвардия создан для тех') &&
            text.includes('вызовам современного мира')
        );
    });


    const contacts = [...document.querySelectorAll('section, div')].find((el) => {
        const text = (el.innerText || '').replace(/\s+/g, ' ').trim();

        return (
            text.includes('WHATSAPP') &&
            text.includes('TELEGRAM')
        );
    });


    if (manifesto && contacts && manifesto !== contacts) {

        manifesto.classList.add('pre-contact-manifesto');

        const manifestoSection =
            manifesto.tagName === 'SECTION'
                ? manifesto
                : manifesto.closest('section') || manifesto;

        const contactsSection =
            contacts.tagName === 'SECTION'
                ? contacts
                : contacts.closest('section') || contacts;

        manifestoSection.classList.add('pre-contact-manifesto');

        if (contactsSection.parentNode) {
            contactsSection.parentNode.insertBefore(
                manifestoSection,
                contactsSection
            );
        }


        /* ---------------------------------------------
           АНИМАЦИЯ ТОЛЬКО ЭТОГО БЛОКА
        --------------------------------------------- */

        manifestoSection.style.opacity = '0';
        manifestoSection.style.transform = 'translateY(55px)';
        manifestoSection.style.transition =
            'opacity 0.85s cubic-bezier(.22,.61,.36,1), ' +
            'transform 0.85s cubic-bezier(.22,.61,.36,1)';


        const observer = new IntersectionObserver(
            ([entry]) => {

                if (entry.isIntersecting) {
                    manifestoSection.style.opacity = '1';
                    manifestoSection.style.transform = 'translateY(0)';
                } else {
                    manifestoSection.style.opacity = '0';
                    manifestoSection.style.transform = 'translateY(55px)';
                }

            },
            {
                threshold: 0.22,
                rootMargin: '0px 0px -8% 0px'
            }
        );

        observer.observe(manifestoSection);
    }

});



/* =========================================================
   FINAL MOTOGUARDIA SCROLL ANIMATIONS
========================================================= */

document.addEventListener("DOMContentLoaded", () => {

    /* -----------------------------------------------------
       1. КАРТОЧКИ ВЪЕЗЖАЮТ ПРИ СКРОЛЛЕ
       И УЕЗЖАЮТ ОБРАТНО ПРИ ОБРАТНОМ СКРОЛЛЕ
    ----------------------------------------------------- */

    const cardSelectors = [
        ".principle-card",
        ".principles__card",
        ".audience-card",
        ".audience__card",
        ".system-card",
        ".system__card",
        ".direction-card",
        ".direction__card",
        ".directions__card",
        ".team-card",
        ".team__card",
        ".opportunity-card",
        ".opportunities__card",
        ".education__step",
        ".education__photo"
    ];

    const cards = [
        ...document.querySelectorAll(cardSelectors.join(","))
    ];

    cards.forEach((card, index) => {
        card.classList.add("scroll-reveal-card");

        card.style.transitionDelay =
            `${Math.min((index % 6) * 55, 275)}ms`;
    });


    const cardObserver = new IntersectionObserver(
        entries => {
            entries.forEach(entry => {

                /*
                ВАЖНО:
                класс удаляем при выходе.
                Поэтому анимация работает
                и вниз, и обратно вверх.
                */

                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                } else {
                    entry.target.classList.remove("is-visible");
                }

            });
        },
        {
            threshold: 0.15,
            rootMargin: "0px 0px -6% 0px"
        }
    );


    cards.forEach(card => {
        cardObserver.observe(card);
    });



    /* -----------------------------------------------------
       2. НАХОДИМ БЛОК С ЛОГОТИПОМ И ФРАЗОЙ
    ----------------------------------------------------- */

    const manifestoNeedle =
        "Легион Мото Гвардия создан для тех";

    let manifestoText = null;


    document
        .querySelectorAll("p, div, h2, h3")
        .forEach(node => {

            if (manifestoText) return;

            const ownText =
                Array.from(node.childNodes)
                    .filter(child => child.nodeType === Node.TEXT_NODE)
                    .map(child => child.textContent)
                    .join(" ")
                    .trim();

            const fullText =
                node.textContent
                    .replace(/\s+/g, " ")
                    .trim();

            if (
                fullText.includes(manifestoNeedle) &&
                fullText.length < 500
            ) {
                manifestoText = node;
            }

        });


    if (!manifestoText) {
        console.warn(
            "Moto Guardia: manifesto text block not found."
        );
        return;
    }


    /*
    Берём ближайший смысловой контейнер.
    */

    let manifestoSection =
        manifestoText.closest("section");

    if (!manifestoSection) {
        manifestoSection =
            manifestoText.parentElement;
    }


    manifestoSection.classList.add(
        "scroll-manifesto"
    );

    manifestoText.classList.add(
        "scroll-manifesto__text"
    );


    /*
    Ищем логотип внутри этой секции.
    */

    const manifestoLogo =
        manifestoSection.querySelector(
            'img[src*="logo"], img[alt*="Мото"], img[alt*="Moto"], img'
        );


    if (manifestoLogo) {
        manifestoLogo.classList.add(
            "scroll-manifesto__logo"
        );
    }



    /* -----------------------------------------------------
       3. РАЗБИВАЕМ ТЕКСТ НА СЛОВА
    ----------------------------------------------------- */

    const originalText =
        manifestoText.textContent
            .replace(/\s+/g, " ")
            .trim();


    const words =
        originalText.split(" ");


    manifestoText.innerHTML =
        words
            .map(
                word =>
                    `<span class="scroll-manifesto__word">${word}</span>`
            )
            .join(" ");


    const wordElements =
        [
            ...manifestoText.querySelectorAll(
                ".scroll-manifesto__word"
            )
        ];



    /* -----------------------------------------------------
       4. ПРОГРЕСС АНИМАЦИИ ОТ СКРОЛЛА
    ----------------------------------------------------- */

    function updateManifesto() {

        const rect =
            manifestoSection.getBoundingClientRect();

        const viewport =
            window.innerHeight;


        /*
        Старт:
        блок входит снизу.

        Конец:
        блок проходит центральную часть экрана.
        */

        const start =
            viewport * 0.82;

        const end =
            viewport * 0.22;


        const progress =
            Math.max(
                0,
                Math.min(
                    1,
                    (start - rect.top) /
                    (start - end)
                )
            );


        /*
        Подсветка идёт слово за словом.
        При обратном скролле всё естественно
        возвращается обратно в серый.
        */

        const illuminated =
            Math.floor(
                progress *
                (wordElements.length + 3)
            );


        wordElements.forEach(
            (word, index) => {

                if (index < illuminated) {
                    word.classList.add("is-lit");
                } else {
                    word.classList.remove("is-lit");
                }

            }
        );

    }


    let manifestoRAF = null;


    function requestManifestoUpdate() {

        if (manifestoRAF) return;

        manifestoRAF =
            requestAnimationFrame(() => {

                updateManifesto();

                manifestoRAF = null;

            });

    }


    window.addEventListener(
        "scroll",
        requestManifestoUpdate,
        { passive: true }
    );


    window.addEventListener(
        "resize",
        requestManifestoUpdate
    );


    updateManifesto();

});


/* =========================================================
   MANIFESTO SCROLL REVEAL
   серый -> белый при скролле вниз
   белый -> серый при скролле вверх
========================================================= */

document.addEventListener("DOMContentLoaded", () => {

    const needle = "Легион Мото Гвардия создан для тех";

    let textEl = null;

    document.querySelectorAll("p, div").forEach(el => {
        if (textEl) return;

        const text = el.textContent.replace(/\s+/g, " ").trim();

        if (
            text.includes(needle) &&
            text.length < 500
        ) {
            textEl = el;
        }
    });

    if (!textEl) {
        console.warn("Manifesto text not found");
        return;
    }

    const section =
        textEl.closest("section") ||
        textEl.parentElement;

    section.classList.add("pre-contact-manifesto");

    const originalText =
        textEl.textContent
            .replace(/\s+/g, " ")
            .trim();

    if (!textEl.querySelector(".manifesto-word")) {
        textEl.innerHTML =
            originalText
                .split(" ")
                .map(word =>
                    `<span class="manifesto-word">${word}</span>`
                )
                .join(" ");
    }

    const words =
        [...textEl.querySelectorAll(".manifesto-word")];

    function updateManifesto() {

        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;

        /*
          Старт — когда блок входит снизу
          Конец — когда верх блока проходит верхнюю треть экрана
        */

        const start = vh * 0.82;
        const end = vh * 0.18;

        const progress =
            Math.max(
                0,
                Math.min(
                    1,
                    (start - rect.top) / (start - end)
                )
            );

        /*
          Немного растягиваем диапазон,
          чтобы слова проявлялись плавнее
        */

        const litCount =
            Math.floor(
                progress * (words.length + 4)
            );

        words.forEach((word, index) => {
            if (index < litCount) {
                word.classList.add("is-lit");
            } else {
                word.classList.remove("is-lit");
            }
        });
    }

    let ticking = false;

    function onScroll() {
        if (ticking) return;

        ticking = true;

        requestAnimationFrame(() => {
            updateManifesto();
            ticking = false;
        });
    }

    window.addEventListener(
        "scroll",
        onScroll,
        { passive: true }
    );

    window.addEventListener(
        "resize",
        updateManifesto
    );

    updateManifesto();

});



